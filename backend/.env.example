# Backend Environment Configuration for Scanio AI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
MAX_IMAGE_BYTES=8000000

# Active Vision Provider (nvidia | openrouter)
VISION_PROVIDER=nvidia

# NVIDIA NIM API Configuration (set real key in Render Dashboard or local untracked .env)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
